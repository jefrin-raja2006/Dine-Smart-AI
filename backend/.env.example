# ---- Required ---------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/dinesmart

# ---- Recommended ------------------------------------------------------
# Secret used to sign login tokens. REQUIRED (32+ chars) when ENVIRONMENT=production.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# development | production
ENVIRONMENT=development

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Optional ---------------------------------------------------------
# Login lifetime in minutes (default 1440 = 24 h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Failed logins allowed per IP+email in the window (default 5 / 900 s)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900

# Seconds to cache OpenStreetMap results per location (default 300)
NEARBY_CACHE_TTL_SECONDS=300

# Comma-separated Overpass API servers (defaults to public instances)
# OVERPASS_SERVERS=https://overpass-api.de/api/interpreter
